# Salin ke .env lalu sesuaikan. File .env tidak ikut ke Git.
# Aplikasi membaca variabel ini dari environment; untuk memuat .env saat
# development jalankan: node --env-file=.env src/server.js

# development | production | test
NODE_ENV=development

# Port HTTP server.
PORT=3000

# Lokasi file SQLite. Bawaan: data/lobbyquest.db
DATABASE_PATH=./data/lobbyquest.db

# Secret acak minimal 32 karakter, WAJIB saat production.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=ganti-dengan-secret-acak-ini-hanya-contoh-palsu

# URL publik aplikasi (tanpa garis miring di akhir), dipakai untuk tautan
# berbagi, file kalender, dan preview tautan. Kosongkan saat development.
PUBLIC_URL=

# Isi bila aplikasi berada di belakang reverse proxy, misalnya 1 atau loopback.
TRUST_PROXY=

# Agenda dihapus otomatis setelah sekian hari sejak pilihan waktu terakhir.
RETENTION_DAYS=30
