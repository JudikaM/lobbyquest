<%- include('partials/header') %>

<% if (justCreated) { %>
<p class="success" role="status">Agenda berhasil dibuat. Bagikan tautan di bawah ke teman-temanmu.</p>
<% } %>

<article class="agenda">
  <p class="badge"><%= kindLabel %></p>
  <h1><%= agenda.title %></h1>

  <% if (agenda.description) { %>
  <p class="description"><%= agenda.description %></p>
  <% } %>

  <% if (agenda.location) { %>
  <p><strong>Lokasi/platform:</strong> <%= agenda.location %></p>
  <% } %>

  <section class="status" id="status" aria-labelledby="status-judul">
    <h2 id="status-judul" class="visually-hidden">Status agenda</h2>
    <p class="status-pill status-<%= status %>"><%= statusLabel %></p>
    <ol class="status-steps" aria-label="Tahapan agenda">
      <li class="<%= status === 'voting' ? 'is-current' : 'is-done' %>"<% if (status === 'voting') { %> aria-current="step"<% } %>>Voting</li>
      <li class="<%= status === 'scheduled' ? 'is-current' : (status === 'done' ? 'is-done' : '') %>"<% if (status === 'scheduled') { %> aria-current="step"<% } %>>Waktu ditetapkan</li>
      <li class="<%= status === 'done' ? 'is-current' : '' %>"<% if (status === 'done') { %> aria-current="step"<% } %>>Selesai</li>
    </ol>
    <% if (finalSaved) { %>
    <p class="success" role="status">Waktu final sudah ditetapkan.</p>
    <% } %>
    <% if (finalLabel) { %>
    <div class="final-time">
      <p class="final-label"><%= status === 'done' ? 'Sudah berlangsung' : 'Waktu final' %></p>
      <p class="final-value"><%= finalLabel %></p>
    </div>
    <% } else if (status === 'expired') { %>
    <p class="note">Semua pilihan waktu sudah lewat tanpa waktu final.</p>
    <% } %>
  </section>

  <h2>Pilihan waktu</h2>
  <p class="note">
    <%= participantCount %> orang sudah memilih. Semua waktu ditampilkan dalam <%= timezoneLabel %>.
  </p>
  <ol class="time-options">
    <% timeOptions.forEach((option) => { %>
    <li class="<%= option.isTop ? 'is-top' : '' %> <%= option.isFinal ? 'is-final' : '' %>">
      <span class="time-label"><%= option.label %><% if (option.isFinal) { %> <strong class="tag">Final</strong><% } %></span>
      <span class="vote-count">
        <%= option.voters.length %> bisa<% if (option.isTop) { %> · paling banyak dipilih<% } %>
      </span>
      <% if (option.voters.length) { %>
      <span class="voters"><%= option.voters.join(', ') %></span>
      <% } %>
    </li>
    <% }) %>
  </ol>
</article>

<% if (status === 'scheduled' || status === 'done') { %>
<section class="rsvp" id="hadir" aria-labelledby="hadir-judul">
  <h2 id="hadir-judul">Konfirmasi kehadiran</h2>

  <ul class="rsvp-summary">
    <% Object.entries(rsvpLabels).forEach(([key, label]) => { %>
    <li class="rsvp-group rsvp-<%= key %>">
      <span class="rsvp-count"><%= rsvpSummary[key].length %></span>
      <span class="rsvp-label"><%= label %></span>
      <% if (rsvpSummary[key].length) { %>
      <span class="rsvp-names"><%= rsvpSummary[key].join(', ') %></span>
      <% } %>
    </li>
    <% }) %>
  </ul>
  <% if (rsvpSummary.pending.length) { %>
  <p class="note">Belum konfirmasi: <%= rsvpSummary.pending.join(', ') %></p>
  <% } %>

  <% if (rsvpSaved) { %>
  <p class="success" role="status">Konfirmasimu sudah disimpan.</p>
  <% } %>
  <% if (rsvpErrors.length) { %>
  <div class="errors" role="alert">
    <p>Konfirmasi belum disimpan:</p>
    <ul>
      <% rsvpErrors.forEach((error) => { %>
      <li><%= error %></li>
      <% }) %>
    </ul>
  </div>
  <% } %>

  <% if (status === 'scheduled') { %>
  <form class="form" method="post" action="/a/<%= agenda.slug %>/hadir">
    <%- include('partials/csrf') %>
    <label class="field">
      Nama panggilan
      <input type="text" name="name" value="<%= rsvpValues.name %>"
        required maxlength="<%= nameMax %>" placeholder="Contoh: Budi" autocomplete="nickname">
      <small>Nama dan konfirmasimu terlihat oleh siapa pun yang memiliki tautan.</small>
    </label>
    <fieldset class="field">
      <legend>Kamu ikut?</legend>
      <div class="choices rsvp-choices">
        <% Object.entries(rsvpLabels).forEach(([key, label]) => { %>
        <label class="choice">
          <input type="radio" name="status" value="<%= key %>" required
            <%= rsvpValues.status === key ? 'checked' : '' %>>
          <%= label %>
        </label>
        <% }) %>
      </div>
    </fieldset>
    <button type="submit" class="primary-button">
      <%= participant && participant.rsvp ? 'Perbarui konfirmasi' : 'Kirim konfirmasi' %>
    </button>
  </form>
  <% } %>
</section>
<% } %>

<% if (status === 'voting') { %>
<section class="vote" id="suara">
  <h2><%= participant ? 'Ubah pilihanmu' : 'Pilih waktu yang kamu bisa' %></h2>

  <% if (voteSaved) { %>
  <p class="success" role="status">Pilihanmu sudah disimpan.</p>
  <% } %>

  <% if (voteErrors.length) { %>
  <div class="errors" role="alert">
    <p>Pilihan belum disimpan:</p>
    <ul>
      <% voteErrors.forEach((error) => { %>
      <li><%= error %></li>
      <% }) %>
    </ul>
  </div>
  <% } %>

  <form class="form" method="post" action="/a/<%= agenda.slug %>/suara">
    <%- include('partials/csrf') %>
    <label class="field">
      Nama panggilan
      <input type="text" name="name" value="<%= voteValues.name %>"
        required maxlength="<%= nameMax %>" placeholder="Contoh: Budi">
      <small>Nama dan pilihanmu terlihat oleh siapa pun yang memiliki tautan.</small>
    </label>

    <fieldset class="field">
      <legend>Waktu yang kamu bisa</legend>
      <small>Centang semua yang cocok. Kosongkan jika tidak ada yang bisa.</small>
      <div class="vote-options">
        <% timeOptions.forEach((option) => { %>
        <label class="choice">
          <input type="checkbox" name="option" value="<%= option.id %>"
            <%= voteValues.optionIds.includes(option.id) ? 'checked' : '' %>>
          <%= option.label %>
        </label>
        <% }) %>
      </div>
    </fieldset>

    <button type="submit" class="primary-button">
      <%= participant ? 'Perbarui pilihan' : 'Simpan pilihan' %>
    </button>
  </form>
</section>
<% } %>

<% if (leftAgenda) { %>
<p class="success" role="status">Nama, suara, dan konfirmasimu sudah dihapus dari agenda ini.</p>
<% } %>

<% if (participant) { %>
<section class="leave" aria-label="Data kamu di agenda ini">
  <form method="post" action="/a/<%= agenda.slug %>/keluar">
    <%- include('partials/csrf') %>
    <p class="note">
      Kamu tercatat sebagai <strong><%= participant.name %></strong> di browser ini.
      <button type="submit" class="link-button">Hapus namaku dari agenda ini</button>
    </p>
  </form>
</section>
<% } %>

<% if (isManager) { %>
<section class="manage" id="kelola" aria-labelledby="kelola-judul">
  <h2 id="kelola-judul">Panel pengelola</h2>
  <% if (managerWelcome) { %>
  <p class="success" role="status">Kamu masuk sebagai pengelola agenda ini.</p>
  <% } %>
  <p class="note">Hanya kamu yang melihat bagian ini.</p>

  <% if (manageErrors.length) { %>
  <div class="errors" role="alert">
    <ul>
      <% manageErrors.forEach((error) => { %>
      <li><%= error %></li>
      <% }) %>
    </ul>
  </div>
  <% } %>

  <% if (status === 'voting' || status === 'scheduled') { %>
  <form class="form" method="post" action="/a/<%= agenda.slug %>/tetapkan">
    <%- include('partials/csrf') %>
    <fieldset class="field">
      <legend><%= status === 'scheduled' ? 'Ganti waktu final' : 'Tetapkan waktu final' %></legend>
      <small>Pilih dari hasil voting. Hanya pilihan yang belum dimulai yang bisa ditetapkan.</small>
      <div class="vote-options">
        <% timeOptions.forEach((option) => { %>
        <label class="choice">
          <input type="radio" name="option" value="<%= option.id %>" required
            <%= option.canFinalize ? '' : 'disabled' %>
            <%= (option.isFinal || (!finalLabel && option.isTop)) && option.canFinalize ? 'checked' : '' %>>
          <span><%= option.label %> · <%= option.voters.length %> bisa</span>
        </label>
        <% }) %>
      </div>
    </fieldset>
    <button type="submit" class="primary-button">
      <%= status === 'scheduled' ? 'Simpan waktu final' : 'Tetapkan waktu' %>
    </button>
  </form>
  <% } %>

  <% if (status === 'scheduled') { %>
  <form method="post" action="/a/<%= agenda.slug %>/buka-voting">
    <%- include('partials/csrf') %>
    <button type="submit" class="secondary-button">Buka voting lagi</button>
  </form>
  <% } %>

  <details class="manager-link">
    <summary>Kelola dari perangkat lain</summary>
    <p class="note">
      Simpan tautan ini di tempat aman dan jangan dibagikan. Siapa pun yang
      memilikinya bisa mengelola agenda ini.
    </p>
    <label class="field">
      Tautan pengelola
      <input type="text" value="<%= managerUrl %>" readonly data-select-on-focus>
    </label>
    <label class="field">
      Atau kode pengelola
      <input type="text" value="<%= managerCode %>" readonly data-select-on-focus>
    </label>
  </details>

  <details class="danger-zone">
    <summary>Hapus agenda</summary>
    <form class="form" method="post" action="/a/<%= agenda.slug %>/hapus">
      <%- include('partials/csrf') %>
      <p class="note">
        Agenda, pilihan waktu, suara, dan konfirmasi kehadiran akan dihapus
        permanen. Tautan agenda tidak bisa dibuka lagi.
      </p>
      <label class="choice">
        <input type="checkbox" name="konfirmasi" value="ya" required>
        Ya, hapus agenda ini secara permanen
      </label>
      <button type="submit" class="danger-button">Hapus agenda</button>
    </form>
  </details>

  <form method="post" action="/a/<%= agenda.slug %>/kelola/keluar">
    <%- include('partials/csrf') %>
    <button type="submit" class="link-button">Lupakan akses pengelola di browser ini</button>
  </form>
</section>
<% } %>

<section class="share">
  <label class="field">
    Tautan berbagi
    <input type="text" value="<%= shareUrl %>" readonly data-select-on-focus>
  </label>
  <p class="note"><%= privacyNotice %></p>
  <p class="note">Agenda ini dihapus otomatis sekitar <%= expiresLabel %>.</p>
</section>

<script type="module" src="/agenda.js"></script>

<%- include('partials/footer') %>
