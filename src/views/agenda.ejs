<%- include('partials/header') %>

<%
  const statusBadge = {
    voting: { cls: 'badge-info', icon: null },
    scheduled: { cls: 'badge-ready', icon: 'lock' },
    done: { cls: 'badge-outline', icon: 'flag' },
    expired: { cls: 'badge-afk', icon: 'clock' },
  }[status];
  const questIndex = { voting: 0, expired: 0, scheduled: 1, done: 2 }[status];
  const questSteps = [['vote', 'Voting'], ['lock', 'Jadwal dikunci'], ['flag', 'Selesai']];
%>

<div class="container agenda-page" data-agenda-timezone="<%= agenda.timezone %>">
  <% if (justCreated) { %>
  <section class="card created-card" aria-labelledby="dibuat-judul">
    <div class="card-content created-body">
      <span class="created-icon"><%- icon('party-popper', { size: 24 }) %></span>
      <div class="created-copy">
        <h2 class="card-title" id="dibuat-judul">Lobby siap. Ajak party-mu!</h2>
        <p class="card-description">Bagikan tautan ini ke grup. Teman cukup menulis nama panggilan lalu memilih waktu.</p>
      </div>
      <%- include('partials/invite', { inviteId: 'share-url-top' }) %>
    </div>
  </section>
  <% } %>

  <% if (voteErrors.length && status !== 'voting') { %>
  <%- include('partials/ui/alert', { alert: { variant: 'warning', title: 'Pilihan belum disimpan', items: voteErrors } }) %>
  <% } %>

  <div class="agenda-layout">
    <div class="agenda-main">
      <header class="card lobby-hero" aria-labelledby="agenda-judul">
        <div class="card-content stack">
          <div class="lobby-top">
            <p class="btn-row">
              <span class="badge badge-outline"><%- icon(agenda.kind === 'mabar' ? 'gamepad-2' : 'coffee') %><%= kindLabel %></span>
              <span class="badge <%= statusBadge.cls %> status-<%= status %>">
                <% if (statusBadge.icon) { %><%- icon(statusBadge.icon) %><% } else { %><span class="dot dot-live"></span><% } %><%= statusLabel %>
              </span>
            </p>
            <div class="btn-row lobby-actions">
              <% if (status === 'voting' && !participant) { %>
              <a class="btn btn-brand btn-sm" href="#suara"><%- icon('user-plus') %>Pilih waktu</a>
              <% } else if (status === 'scheduled' && !(participant && participant.rsvp)) { %>
              <a class="btn btn-brand btn-sm" href="#hadir"><%- icon('check-check') %>Jawab ready check</a>
              <% } %>
              <% if (status === 'scheduled') { %>
              <a class="btn btn-outline btn-sm" href="<%= calendarUrl %>" download><%- icon('calendar-plus') %>Kalender</a>
              <% } %>
              <% if (!justCreated) { %>
              <a class="btn btn-outline btn-sm" href="#bagikan"><%- icon('share-2') %>Bagikan</a>
              <% } %>
            </div>
          </div>

          <h1 class="lobby-title" id="agenda-judul"><%= agenda.title %></h1>
          <% if (agenda.description) { %>
          <p class="lobby-description"><%= agenda.description %></p>
          <% } %>

          <ul class="lobby-meta">
            <% if (agenda.location) { %>
            <li><%- icon('map-pin') %><span class="sr-only">Lokasi atau platform: </span><%= agenda.location %></li>
            <% } %>
            <li><%- icon('globe') %><span class="sr-only">Zona waktu: </span><%= timezoneLabel %></li>
            <li><%- icon('users') %><%= participantCount %> orang di lobby<% if (capacity) { %> · kuota hadir <%= capacity %><% } %></li>
          </ul>

          <ol class="quest" aria-label="Tahapan agenda">
            <% questSteps.forEach(([iconName, label], i) => { %>
            <% const state = i < questIndex || (status === 'done' && i === 2) ? 'is-done' : (i === questIndex && status !== 'expired' ? 'is-current' : ''); %>
            <li class="quest-step <%= state %>"<% if (i === questIndex && status !== 'expired') { %> aria-current="step"<% } %>>
              <span class="quest-node"><%- icon(state === 'is-done' ? 'check' : iconName) %></span><%= label %>
            </li>
            <% }) %>
          </ol>
        </div>
      </header>

      <% if (finalParts) { %>
      <section class="card final-card final-<%= status %>" id="status" aria-labelledby="final-judul">
        <div class="card-content final-body">
          <%- include('partials/ui/date-tile', { tile: { weekday: finalParts.weekday, day: finalParts.day, month: finalParts.month, variant: status === 'scheduled' ? 'brand date-tile-lg' : 'lg' } }) %>
          <div class="final-copy">
            <p class="kicker" id="final-judul"><%- icon(status === 'done' ? 'flag' : 'lock') %><%= status === 'done' ? 'Sudah berlangsung' : 'Waktu final' %></p>
            <p class="final-time mono"><%= finalParts.range %> <span class="final-zone"><%= finalParts.zone %></span></p>
            <p class="final-date" data-local-time data-start="<%= agenda.finalOption.starts_at %>" data-end="<%= agenda.finalOption.ends_at %>"><%= finalParts.date %></p>
            <% if (status === 'scheduled') { %>
            <p class="countdown" data-countdown data-start="<%= agenda.finalOption.starts_at %>" data-end="<%= agenda.finalOption.ends_at %>" hidden></p>
            <% } %>
          </div>
        </div>
        <% if (status === 'scheduled') { %>
        <div class="card-footer final-actions">
          <a class="btn btn-primary btn-sm" href="<%= calendarUrl %>" download><%- icon('download') %>Simpan ke kalender (.ics)</a>
          <a class="btn btn-outline btn-sm" href="<%= googleCalendarUrl %>" target="_blank" rel="noopener noreferrer"><%- icon('external-link') %>Google Calendar</a>
        </div>
        <% } %>
      </section>
      <% } else if (status === 'expired') { %>
      <%- include('partials/ui/alert', { alert: { variant: 'warning', title: 'Jadwal tidak jadi dikunci', text: 'Semua pilihan waktu sudah lewat tanpa waktu final.' } }) %>
      <% } %>

      <% if (rsvpOpen) { %>
      <section class="card ready-card" id="hadir" aria-labelledby="hadir-judul">
        <div class="card-header">
          <div class="card-header-row">
            <h2 class="card-title" id="hadir-judul"><%- icon('check-check', { size: 18 }) %>Ready check</h2>
            <p class="ready-score"><span class="ready-score-num"><%= rsvpSummary.yes.length %></span><span class="ready-score-of">/<%= capacity || participantCount %> siap</span></p>
          </div>
          <p class="card-description">Konfirmasi kehadiran untuk waktu final.</p>
        </div>
        <div class="card-content stack">
          <span class="segbar segbar-lg" role="img"
            aria-label="<%= rsvpSummary.yes.length %> siap, <%= rsvpSummary.maybe.length %> mungkin, <%= rsvpSummary.no.length %> absen, <%= rsvpSummary.pending.length %> belum menjawab">
            <span class="seg-yes <%= rsvpGrow.yes %>"></span><span class="seg-maybe <%= rsvpGrow.maybe %>"></span><span class="seg-no <%= rsvpGrow.no %>"></span><span class="seg-pending <%= rsvpGrow.pending %>"></span>
          </span>

          <div class="stats stats-4">
            <% [['yes', rsvpLabels.yes], ['maybe', rsvpLabels.maybe], ['no', rsvpLabels.no], ['pending', 'AFK']].forEach(([key, label]) => { %>
            <div class="stat stat-<%= key %>" data-count="<%= rsvpSummary[key].length %>">
              <span class="stat-label"><%- icon(rsvpIcons[key]) %><%= label %><% if (key === 'pending') { %><span class="sr-only"> (belum menjawab)</span><% } %></span>
              <span class="stat-value"><%= rsvpSummary[key].length %></span>
              <% if (rsvpSummary[key].length) { %><span class="stat-names"><%= rsvpSummary[key].join(', ') %></span><% } %>
            </div>
            <% }) %>
          </div>

          <% if (rsvpSummary.pending.length) { %>
          <p class="hint"><%- icon('hourglass') %> Belum konfirmasi: <%= rsvpSummary.pending.join(', ') %></p>
          <% } %>

          <% if (capacity) { %>
          <div class="party-slots<%= capacityFull ? ' is-full' : '' %>">
            <span class="slot-pips" aria-hidden="true"><% capacitySlots.forEach((filled) => { %><span class="pip<%= filled ? ' is-filled' : '' %>"></span><% }) %></span>
            <span><strong><%= Math.min(rsvpSummary.yes.length, capacity) %>/<%= capacity %></strong> slot terisi<%= capacityFull ? ' · party penuh' : '' %></span>
          </div>
          <% } %>

          <% if (rsvpErrors.length) { %>
          <%- include('partials/ui/alert', { alert: { variant: 'destructive', title: 'Konfirmasi belum disimpan', items: rsvpErrors, focus: true } }) %>
          <% } %>

          <% if (status === 'scheduled') { %>
          <form class="stack rsvp-form" method="post" action="/a/<%= agenda.slug %>/hadir">
            <%- include('partials/csrf') %>
            <div class="field">
              <label class="label" for="rsvp-name">Nama panggilan</label>
              <input class="input" id="rsvp-name" type="text" name="name" value="<%= rsvpValues.name %>"
                required maxlength="<%= nameMax %>" placeholder="Contoh: Budi" autocomplete="nickname"
                aria-describedby="rsvp-name-hint">
              <p class="hint" id="rsvp-name-hint">Nama dan jawabanmu terlihat oleh siapa pun yang memiliki tautan.</p>
            </div>
            <fieldset class="field">
              <legend class="label">Kamu ikut?</legend>
              <div class="segmented">
                <% Object.entries(rsvpLabels).forEach(([key, label]) => { %>
                <label class="segment segment-<%= key %>">
                  <input type="radio" name="status" value="<%= key %>" required <%= rsvpValues.status === key ? 'checked' : '' %>>
                  <%- icon(rsvpIcons[key]) %>
                  <span class="segment-label"><%= label %></span>
                  <span class="segment-hint"><%= rsvpHints[key] %></span>
                </label>
                <% }) %>
              </div>
            </fieldset>
            <button type="submit" class="btn btn-brand btn-lg btn-block">
              <%- icon('check-check') %><%= participant && participant.rsvp ? 'Perbarui jawaban' : 'Kirim jawaban' %>
            </button>
          </form>
          <% } %>
        </div>
      </section>
      <% } %>

      <section class="card results-card" id="hasil" aria-labelledby="hasil-judul">
        <div class="card-header">
          <div class="card-header-row">
            <h2 class="card-title" id="hasil-judul"><%- icon('vote', { size: 18 }) %>Hasil voting</h2>
            <span class="kicker"><%= timezoneLabel %></span>
          </div>
          <p class="card-description"><%= participantCount %> orang sudah memilih.<span data-local-zone-note></span></p>
        </div>
        <div class="card-content">
          <ol class="results">
            <% timeOptions.forEach((option) => { %>
            <li class="result<%= option.isTop ? ' is-top' : '' %><%= option.isFinal ? ' is-final' : '' %>">
              <%- include('partials/ui/date-tile', { tile: { weekday: option.parts.weekday, day: option.parts.day, month: option.parts.month, variant: option.isFinal ? 'brand' : '' } }) %>
              <div class="result-body">
                <div class="result-head">
                  <p class="result-when" data-local-time data-start="<%= option.startsAt %>" data-end="<%= option.endsAt %>">
                    <span class="result-range mono"><%= option.parts.range %></span>
                    <span class="result-date"><%= option.parts.date %></span>
                  </p>
                  <% if (option.isFinal) { %>
                  <span class="badge badge-brand"><%- icon('lock') %>Final</span>
                  <% } else if (option.isTop) { %>
                  <span class="badge badge-outline"><%- icon('crown') %>Teratas</span>
                  <% } %>
                </div>
                <span class="bar" aria-hidden="true"><span class="bar-value<%= option.isTop ? ' is-lead' : '' %> <%= option.width %>"></span></span>
                <div class="result-foot">
                  <% if (participantCount) { %>
                  <p class="result-count"><strong><%= option.voters.length %></strong> dari <%= participantCount %> bisa</p>
                  <% } else { %>
                  <p class="result-count">Belum ada suara</p>
                  <% } %>
                  <% if (option.avatars.length) { %>
                  <span class="avatar-stack" aria-hidden="true">
                    <% option.avatars.forEach((av) => { %><span class="avatar avatar-sm <%= av.avatar %>"><%= av.initial %></span><% }) %>
                    <% if (option.moreVoters) { %><span class="avatar avatar-sm avatar-more">+<%= option.moreVoters %></span><% } %>
                  </span>
                  <% } %>
                </div>
                <% if (option.voters.length) { %>
                <p class="result-names"><span class="sr-only">Yang bisa: </span><%= option.voters.join(', ') %></p>
                <% } %>
              </div>
            </li>
            <% }) %>
          </ol>
        </div>
      </section>

      <% if (status === 'voting') { %>
      <section class="card vote-card" id="suara" aria-labelledby="suara-judul">
        <div class="card-header">
          <h2 class="card-title" id="suara-judul"><%- icon(participant ? 'calendar-check' : 'user-plus', { size: 18 }) %><%= participant ? 'Ubah pilihanmu' : 'Gabung lobby & pilih waktu' %></h2>
          <p class="card-description">Centang semua waktu yang kamu bisa. Kosongkan jika tidak ada yang cocok.</p>
        </div>
        <div class="card-content">
          <% if (voteErrors.length) { %>
          <%- include('partials/ui/alert', { alert: { variant: 'destructive', title: 'Pilihan belum disimpan', items: voteErrors, focus: true } }) %>
          <% } %>
          <form class="stack" method="post" action="/a/<%= agenda.slug %>/suara">
            <%- include('partials/csrf') %>
            <div class="field">
              <label class="label" for="vote-name">Nama panggilan</label>
              <input class="input" id="vote-name" type="text" name="name" value="<%= voteValues.name %>"
                required maxlength="<%= nameMax %>" placeholder="Contoh: Budi" autocomplete="nickname"
                aria-describedby="vote-name-hint">
              <p class="hint" id="vote-name-hint">Nama dan pilihanmu terlihat oleh siapa pun yang memiliki tautan.</p>
            </div>
            <fieldset class="field">
              <legend class="label">Waktu yang kamu bisa</legend>
              <div class="option-list">
                <% timeOptions.forEach((option) => { %>
                <label class="option-card">
                  <%- include('partials/ui/date-tile', { tile: { weekday: option.parts.weekday, day: option.parts.day, month: option.parts.month } }) %>
                  <span class="option-time">
                    <span class="option-time-range"><%= option.parts.range %> <%= option.parts.zone %></span>
                    <span class="option-time-date"><%= option.parts.date %></span>
                  </span>
                  <span class="checkbox">
                    <input type="checkbox" name="option" value="<%= option.id %>" <%= voteValues.optionIds.includes(option.id) ? 'checked' : '' %>><%- icon('check') %>
                  </span>
                </label>
                <% }) %>
              </div>
            </fieldset>
            <button type="submit" class="btn btn-brand btn-lg btn-block">
              <%- icon('check') %><%= participant ? 'Perbarui pilihan' : 'Simpan pilihan' %>
            </button>
          </form>
        </div>
      </section>
      <% } %>
    </div>

    <aside class="agenda-aside" aria-label="Lobby, undangan, dan pengelolaan">
      <section class="card lobby-card" aria-labelledby="party-judul">
        <div class="card-header">
          <div class="card-header-row">
            <h2 class="card-title" id="party-judul"><%- icon('users', { size: 18 }) %>Lobby</h2>
            <span class="kicker"><%= participantCount %> pemain</span>
          </div>
        </div>
        <div class="card-content">
          <% if (party.length) { %>
          <ul class="lobby-list">
            <% party.forEach((member) => { %>
            <li class="lobby-member<%= member.isYou ? ' is-you' : '' %>">
              <span class="avatar <%= member.avatar %>" aria-hidden="true"><%= member.initial %><% if (member.rsvp) { %><span class="avatar-status status-<%= member.rsvp %>"><%- icon(member.rsvp === 'yes' ? 'check' : member.rsvp === 'maybe' ? 'circle-help' : 'x') %></span><% } %></span>
              <span class="lobby-name"><%= member.name %><% if (member.isYou) { %> <span class="lobby-you">(kamu)</span><% } %></span>
              <% if (member.state === 'voted') { %>
              <span class="badge badge-outline"><%- icon('calendar-check') %><%= member.picks %> waktu</span>
              <% } else if (member.state === 'pending') { %>
              <span class="badge badge-afk"><%- icon('hourglass') %>AFK</span>
              <% } else { %>
              <span class="badge badge-<%= member.state %>"><%- icon(rsvpIcons[member.state]) %><%= rsvpLabels[member.state] %></span>
              <% } %>
            </li>
            <% }) %>
          </ul>
          <% } else { %>
          <%- include('partials/ui/empty', { empty: { icon: 'users', title: 'Lobby masih kosong', text: 'Bagikan tautan supaya teman-temanmu bisa gabung dan memilih waktu.' } }) %>
          <% } %>
          <% if (participant) { %>
          <form class="leave" method="post" action="/a/<%= agenda.slug %>/keluar">
            <%- include('partials/csrf') %>
            <p class="hint">
              Kamu tercatat sebagai <strong><%= participant.name %></strong> di browser ini.
              <button type="submit" class="btn btn-link leave-button"><%- icon('log-out') %>Hapus namaku dari agenda ini</button>
            </p>
          </form>
          <% } %>
        </div>
      </section>

      <% if (!justCreated) { %>
      <section class="card share-card" id="bagikan" aria-labelledby="bagikan-judul">
        <div class="card-header">
          <h2 class="card-title" id="bagikan-judul"><%- icon('share-2', { size: 18 }) %>Undang ke lobby</h2>
          <p class="card-description">Siapa pun yang punya tautan bisa gabung.</p>
        </div>
        <div class="card-content">
          <%- include('partials/invite', { inviteId: 'share-url' }) %>
        </div>
      </section>
      <% } %>

      <% if (isManager) { %>
      <section class="card manage-card" id="kelola" aria-labelledby="kelola-judul">
        <div class="card-header">
          <div class="card-header-row">
            <h2 class="card-title" id="kelola-judul"><%- icon('crown', { size: 18 }) %>Panel pengelola</h2>
            <span class="badge badge-brand">Host</span>
          </div>
          <p class="card-description">Hanya kamu yang melihat bagian ini.</p>
        </div>
        <div class="card-content">
          <% if (manageErrors.length) { %>
          <%- include('partials/ui/alert', { alert: { variant: 'destructive', items: manageErrors, focus: true } }) %>
          <% } %>
          <div class="tabs" data-tabs>
            <div class="tabs-list" data-tabs-list hidden></div>

            <section class="tabs-panel" data-tab-label="Jadwal">
              <h3 class="tabs-panel-title">Jadwal</h3>
              <% if (status === 'voting' || status === 'scheduled') { %>
              <form class="stack" method="post" action="/a/<%= agenda.slug %>/tetapkan">
                <%- include('partials/csrf') %>
                <fieldset class="field">
                  <legend class="label"><%= status === 'scheduled' ? 'Ganti waktu final' : 'Kunci waktu final' %></legend>
                  <p class="hint">Hanya pilihan yang belum dimulai yang bisa dikunci.</p>
                  <div class="choice-list">
                    <% timeOptions.forEach((option) => { %>
                    <label class="choice">
                      <span class="radio"><input type="radio" name="option" value="<%= option.id %>" required
                        <%= option.canFinalize ? '' : 'disabled' %>
                        <%= (option.isFinal || (!finalParts && option.isTop)) && option.canFinalize ? 'checked' : '' %>></span>
                      <span class="choice-body">
                        <span class="choice-title"><%= option.parts.weekday %> <%= option.parts.day %> <%= option.parts.month %> · <%= option.parts.range %></span>
                        <span class="choice-meta"><%= option.voters.length %> bisa<% if (option.isTop) { %> · teratas<% } %></span>
                      </span>
                    </label>
                    <% }) %>
                  </div>
                </fieldset>
                <button type="submit" class="btn btn-primary"><%- icon('lock') %><%= status === 'scheduled' ? 'Simpan waktu final' : 'Kunci jadwal' %></button>
              </form>
              <% } else { %>
              <p class="hint">Jadwal tidak bisa diubah lagi karena agenda sudah <%= status === 'done' ? 'selesai' : 'lewat' %>.</p>
              <% } %>
              <% if (status === 'scheduled') { %>
              <form method="post" action="/a/<%= agenda.slug %>/buka-voting">
                <%- include('partials/csrf') %>
                <button type="submit" class="btn btn-outline"><%- icon('lock-open') %>Buka voting lagi</button>
              </form>
              <% } %>
            </section>

            <section class="tabs-panel" data-tab-label="Akses">
              <h3 class="tabs-panel-title">Akses</h3>
              <p class="hint">Kelola dari perangkat lain dengan tautan atau kode ini. Simpan di tempat aman dan jangan dibagikan ke grup.</p>
              <div class="field">
                <label class="label" for="manager-url">Tautan pengelola</label>
                <div class="invite-field">
                  <input class="input input-mono" id="manager-url" type="text" value="<%= managerUrl %>" readonly data-select-on-focus>
                  <button type="button" class="btn btn-outline btn-icon" data-copy="#manager-url" data-copy-message="Tautan pengelola tersalin" data-copy-hint="Simpan di tempat aman." data-tooltip="Salin tautan pengelola" data-tooltip-align="end" hidden>
                    <%- icon('copy', { className: 'icon-copy', label: 'Salin tautan pengelola' }) %><%- icon('check', { className: 'icon-copied' }) %>
                  </button>
                </div>
              </div>
              <div class="field">
                <label class="label" for="manager-code">Atau kode pengelola</label>
                <input class="input input-mono" id="manager-code" type="text" value="<%= managerCode %>" readonly data-select-on-focus>
              </div>
              <form method="post" action="/a/<%= agenda.slug %>/kelola/keluar">
                <%- include('partials/csrf') %>
                <button type="submit" class="btn btn-ghost"><%- icon('log-out') %>Lupakan akses pengelola di browser ini</button>
              </form>
            </section>

            <section class="tabs-panel" data-tab-label="Hapus">
              <h3 class="tabs-panel-title">Hapus agenda</h3>
              <p class="hint">Agenda, pilihan waktu, suara, dan konfirmasi kehadiran akan dihapus permanen.</p>
              <details class="disclosure disclosure-danger" data-dialog>
                <summary><%- icon('trash-2') %>Hapus agenda ini<%- icon('chevron-down', { className: 'icon-chevron' }) %></summary>
                <div class="dialog-content disclosure-body" data-dialog-body>
                  <div class="dialog-header">
                    <h3 class="dialog-title" data-dialog-title>Hapus agenda secara permanen?</h3>
                    <p class="dialog-description">Tautan agenda tidak bisa dibuka lagi dan datanya tidak bisa dikembalikan.</p>
                  </div>
                  <form class="stack" method="post" action="/a/<%= agenda.slug %>/hapus">
                    <%- include('partials/csrf') %>
                    <label class="choice">
                      <span class="checkbox"><input type="checkbox" name="konfirmasi" value="ya" required><%- icon('check') %></span>
                      <span class="choice-body"><span class="choice-title">Ya, hapus agenda ini secara permanen</span></span>
                    </label>
                    <div class="dialog-footer">
                      <button type="button" class="btn btn-outline" data-dialog-close hidden>Batal</button>
                      <button type="submit" class="btn btn-destructive"><%- icon('trash-2') %>Hapus agenda</button>
                    </div>
                  </form>
                </div>
              </details>
            </section>
          </div>
        </div>
      </section>
      <% } %>
    </aside>
  </div>

  <p class="fine-print"><%- icon('shield-check') %><span><%= privacyNotice %> Agenda ini dihapus otomatis sekitar <%= expiresLabel %>.</span></p>
</div>

<script type="module" src="/agenda.js"></script>

<%- include('partials/footer') %>
