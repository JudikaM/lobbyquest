<%# Ilustrasi hero: lobby + voting + ready check. Warna dari token CSS,
    sehingga mengikuti tema terang/gelap. Bentuk kecil (crown, gembok,
    kilau, centang) memakai path ikon Lucide. %>
<svg class="hero-art" viewBox="0 0 520 462" role="img" aria-labelledby="hero-art-title">
  <title id="hero-art-title">Ilustrasi lobby LobbyQuest: hasil voting waktu, anggota party, jadwal yang dikunci, dan ready check 4 dari 5 siap.</title>

  <!-- Orbit putus-putus yang menghubungkan kartu -->
  <path class="ha-orbit" d="M34 84 C 6 200, 16 330, 118 414 S 286 458, 318 446"/>
  <circle class="ha-orbit-dot" cx="34" cy="84" r="4"/>
  <circle class="ha-orbit-dot" cx="318" cy="446" r="4"/>

  <!-- Kartu lobby utama -->
  <g class="ha-float-a">
    <rect class="ha-card" x="70" y="56" width="360" height="318" rx="20"/>
    <text class="ha-kicker" x="100" y="100">LOBBY · MABAR</text>
    <text class="ha-title" x="100" y="130">Push rank Sabtu</text>
    <rect class="ha-badge" x="330" y="82" width="76" height="24" rx="7"/>
    <circle class="ha-live" cx="345" cy="94" r="3.5"/>
    <text class="ha-badge-text" x="354" y="98">Voting</text>

    <!-- Hasil voting: sorotan untuk waktu teratas, sisanya netral -->
    <rect class="ha-tile" x="100" y="150" width="40" height="44" rx="9"/>
    <text class="ha-tile-wd" x="120" y="166">SAB</text>
    <text class="ha-tile-day" x="120" y="186">7</text>
    <text class="ha-time" x="154" y="168">19.00–22.00</text>
    <rect class="ha-track" x="154" y="178" width="190" height="8" rx="2"/>
    <rect class="ha-bar-lead" x="154" y="178" width="172" height="8" rx="2"/>
    <text class="ha-count" x="362" y="187">5</text>
    <g class="ha-crown" transform="translate(353 150) scale(0.7)">
      <path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"/>
    </g>

    <rect class="ha-tile" x="100" y="206" width="40" height="44" rx="9"/>
    <text class="ha-tile-wd" x="120" y="222">SAB</text>
    <text class="ha-tile-day" x="120" y="242">7</text>
    <text class="ha-time" x="154" y="224">21.00–23.30</text>
    <rect class="ha-track" x="154" y="234" width="190" height="8" rx="2"/>
    <rect class="ha-bar" x="154" y="234" width="104" height="8" rx="2"/>
    <text class="ha-count" x="362" y="243">3</text>

    <rect class="ha-tile" x="100" y="262" width="40" height="44" rx="9"/>
    <text class="ha-tile-wd" x="120" y="278">MIN</text>
    <text class="ha-tile-day" x="120" y="298">8</text>
    <text class="ha-time" x="154" y="280">20.00–23.00</text>
    <rect class="ha-track" x="154" y="290" width="190" height="8" rx="2"/>
    <rect class="ha-bar" x="154" y="290" width="38" height="8" rx="2"/>
    <text class="ha-count" x="362" y="299">1</text>

    <!-- Party: 4 terisi, 1 slot kosong -->
    <rect class="ha-av ha-av-0" x="100" y="324" width="26" height="26" rx="8"/><text class="ha-av-t ha-av-t0" x="113" y="342">A</text>
    <rect class="ha-av ha-av-3" x="120" y="324" width="26" height="26" rx="8"/><text class="ha-av-t ha-av-t3" x="133" y="342">B</text>
    <rect class="ha-av ha-av-4" x="140" y="324" width="26" height="26" rx="8"/><text class="ha-av-t ha-av-t4" x="153" y="342">C</text>
    <rect class="ha-av ha-av-1" x="160" y="324" width="26" height="26" rx="8"/><text class="ha-av-t ha-av-t1" x="173" y="342">D</text>
    <rect class="ha-av ha-av-slot" x="180" y="324" width="26" height="26" rx="8"/>
    <path class="ha-plus" d="M193 331v12M187 337h12"/>
    <text class="ha-party-text" x="218" y="341">4/5 terisi</text>
  </g>

  <!-- Kartu jadwal dikunci (kiri atas) -->
  <g class="ha-float-c">
    <rect class="ha-card ha-card-pop" x="6" y="8" width="164" height="72" rx="16"/>
    <rect class="ha-tile ha-tile-brand" x="20" y="20" width="40" height="48" rx="9"/>
    <rect class="ha-tile-strip" x="20" y="20" width="40" height="5" rx="2"/>
    <text class="ha-tile-wd" x="40" y="39">SAB</text>
    <text class="ha-tile-day" x="40" y="60">7</text>
    <text class="ha-lock-text" x="72" y="41">19.00</text>
    <g class="ha-lock" transform="translate(122 25) scale(0.72)">
      <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
    </g>
    <text class="ha-muted-sm" x="72" y="61">Jadwal dikunci</text>
  </g>

  <!-- Kartu ready check (kanan bawah) -->
  <g class="ha-float-b">
    <rect class="ha-card ha-card-pop" x="300" y="318" width="200" height="124" rx="18"/>
    <text class="ha-kicker" x="320" y="348">READY CHECK</text>
    <text class="ha-big" x="320" y="386">4/5</text>
    <text class="ha-muted" x="376" y="386">siap</text>
    <rect class="ha-seg-yes" x="320" y="402" width="104" height="8" rx="4"/>
    <rect class="ha-seg-maybe" x="426" y="402" width="24" height="8"/>
    <rect class="ha-seg-afk" x="452" y="402" width="28" height="8" rx="4"/>
    <circle class="ha-ready-ring" cx="466" cy="346" r="14"/>
    <g class="ha-ready-check" transform="translate(457.6 337.6) scale(0.7)">
      <path d="M20 6 9 17l-5-5"/>
    </g>
  </g>

  <!-- Kilau (path ikon sparkles Lucide) -->
  <g transform="translate(452 26) scale(1.25)">
    <path class="ha-sparkle" d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/>
  </g>
  <g transform="translate(452 214) scale(0.8)">
    <path class="ha-sparkle ha-sparkle-sm" d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/>
  </g>
</svg>
