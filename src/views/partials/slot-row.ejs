<fieldset class="slot" data-slot>
  <legend class="slot-number">Pilihan <span data-slot-number><%= number %></span></legend>
  <label>
    <span>Mulai</span>
    <input type="datetime-local" name="start" value="<%= slot.start %>" min="<%= minDateTime %>">
  </label>
  <label>
    <span>Selesai</span>
    <input type="datetime-local" name="end" value="<%= slot.end %>" min="<%= minDateTime %>">
  </label>
  <button type="button" class="button button-ghost button-small slot-remove" data-remove-slot hidden>
    Hapus<span class="visually-hidden"> pilihan ini</span>
  </button>
</fieldset>
