<section class="panel share" id="bagikan" aria-labelledby="bagikan-judul">
  <h2 id="bagikan-judul" class="panel-title">Undang teman</h2>
  <div class="field">
    <label for="share-url">Tautan agenda</label>
    <div class="copy-field">
      <input id="share-url" type="text" value="<%= shareUrl %>" readonly data-select-on-focus>
      <button type="button" class="button button-secondary" data-copy="#share-url" hidden>Salin</button>
    </div>
    <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>
  </div>
  <div class="share-buttons">
    <button type="button" class="button button-primary" data-native-share
      data-share-title="<%= agenda.title %>" data-share-text="<%= shareText %>" data-share-url="<%= shareUrl %>" hidden>
      Bagikan…
    </button>
    <a class="button button-secondary share-whatsapp" href="<%= shareLinks.whatsapp %>" target="_blank" rel="noopener noreferrer">
      WhatsApp
    </a>
    <a class="button button-secondary share-telegram" href="<%= shareLinks.telegram %>" target="_blank" rel="noopener noreferrer">
      Telegram
    </a>
  </div>
</section>
