<%- include('partials/header') %>

<section class="hero" aria-labelledby="hero-judul">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="badge badge-outline hero-badge"><span class="dot dot-live hero-dot"></span>Open source · Tanpa akun · Gratis</p>
      <h1 class="hero-title" id="hero-judul">Kumpulkan <span class="hl">party-mu</span>, tanpa drama jadwal.</h1>
      <p class="lead hero-lead">
        Buat lobby untuk mabar atau nongkrong. Teman memilih waktu langsung dari
        grup chat, kamu kunci jadwalnya, lalu semua menjawab <strong>ready check</strong>.
      </p>
      <div class="btn-row hero-actions">
        <a class="btn btn-brand btn-lg" href="/agenda/baru">Buat lobby <%- icon('arrow-right') %></a>
        <a class="btn btn-outline btn-lg" href="#cara-kerja">Lihat cara kerja</a>
      </div>
      <ul class="hero-trust">
        <li><%- icon('user-x') %>Tanpa daftar akun</li>
        <li><%- icon('shield-check') %>Tanpa pelacak</li>
        <li><%- icon('timer') %>Siap dalam semenit</li>
      </ul>
    </div>
    <div class="hero-visual">
      <%- include('partials/hero-art') %>
    </div>
  </div>
</section>

<section class="section" id="cara-kerja" aria-labelledby="cara-kerja-judul">
  <div class="container">
    <div class="section-head">
      <p class="kicker"><%- icon('list-checks') %> Quest log</p>
      <h2 class="section-title" id="cara-kerja-judul">Dari ajakan sampai semua siap, dalam empat langkah.</h2>
    </div>
    <ol class="steps">
      <% steps.forEach((step, i) => { %>
      <li class="step">
        <span class="step-top">
          <span class="step-icon"><%- icon(step.icon, { size: 20 }) %></span>
          <span class="step-num mono">0<%= i + 1 %></span>
        </span>
        <h3 class="step-title"><%= step.title %></h3>
        <p class="step-text"><%= step.text %></p>
      </li>
      <% }) %>
    </ol>
  </div>
</section>

<section class="section" aria-labelledby="fitur-judul">
  <div class="container">
    <div class="section-head">
      <p class="kicker"><%- icon('sparkles') %> Fitur</p>
      <h2 class="section-title" id="fitur-judul">Semua yang dibutuhkan party, tanpa yang tidak perlu.</h2>
    </div>
    <div class="bento">
      <article class="card bento-tile bento-wide">
        <div class="card-content bento-body">
          <span class="bento-icon"><%- icon('check-check', { size: 20 }) %></span>
          <h3 class="bento-title">Ready check yang jelas</h3>
          <p class="hint">Setelah jadwal dikunci, setiap orang menjawab siap, mungkin, atau absen. Yang belum menjawab tampil sebagai AFK.</p>
          <div class="bento-demo" aria-hidden="true">
            <div class="btn-row">
              <span class="badge badge-ready"><%- icon('circle-check') %>Siap 4</span>
              <span class="badge badge-maybe"><%- icon('circle-help') %>Mungkin 1</span>
              <span class="badge badge-afk"><%- icon('hourglass') %>AFK 1</span>
            </div>
            <span class="segbar"><span class="seg-yes g-4"></span><span class="seg-maybe g-1"></span><span class="seg-pending g-1"></span></span>
          </div>
        </div>
      </article>
      <article class="card bento-tile">
        <div class="card-content bento-body">
          <span class="bento-icon"><%- icon('vote', { size: 20 }) %></span>
          <h3 class="bento-title">Voting waktu langsung</h3>
          <p class="hint">Bar ketersediaan menunjukkan waktu yang paling cocok untuk semua.</p>
          <div class="bento-demo bento-bars" aria-hidden="true">
            <span class="bar"><span class="bar-value is-lead w-90"></span></span>
            <span class="bar"><span class="bar-value w-54"></span></span>
            <span class="bar"><span class="bar-value w-18"></span></span>
          </div>
        </div>
      </article>
      <article class="card bento-tile">
        <div class="card-content bento-body">
          <span class="bento-icon"><%- icon('users', { size: 20 }) %></span>
          <h3 class="bento-title">Kuota party</h3>
          <p class="hint">Batasi yang bisa konfirmasi hadir, misalnya 5 untuk satu squad.</p>
        </div>
      </article>
      <article class="card bento-tile">
        <div class="card-content bento-body">
          <span class="bento-icon"><%- icon('calendar-check', { size: 20 }) %></span>
          <h3 class="bento-title">Masuk ke kalender</h3>
          <p class="hint">Simpan jadwal final sebagai file .ics atau langsung ke Google Calendar.</p>
        </div>
      </article>
      <article class="card bento-tile">
        <div class="card-content bento-body">
          <span class="bento-icon"><%- icon('globe', { size: 20 }) %></span>
          <h3 class="bento-title">Zona waktu otomatis</h3>
          <p class="hint">WIB, WITA, dan WIT, plus jam versi perangkat untuk teman di zona lain.</p>
        </div>
      </article>
      <article class="card bento-tile">
        <div class="card-content bento-body">
          <span class="bento-icon"><%- icon('shield-check', { size: 20 }) %></span>
          <h3 class="bento-title">Privasi bawaan</h3>
          <p class="hint">Tanpa akun dan pelacak. Agenda lama terhapus otomatis, peserta bisa menghapus namanya.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="cta-judul">
  <div class="container">
    <div class="cta-band">
      <div class="cta-copy">
        <p class="kicker cta-kicker"><%- icon('gamepad-2') %> Siap main?</p>
        <h2 class="cta-title" id="cta-judul">Party-mu sudah menunggu.</h2>
        <p class="cta-text">Buat lobby pertama sekarang. Tidak perlu akun, cukup bagikan tautannya.</p>
      </div>
      <a class="btn btn-brand btn-lg" href="/agenda/baru"><%- icon('plus') %>Buat lobby</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
