<%- include('partials/header') %>

<section class="panel narrow">
  <p class="eyebrow">Akses pengelola</p>
  <h1>Masuk sebagai pengelola</h1>
  <p>Agenda: <strong><%= agenda.title %></strong></p>
  <p class="hint">
    Masukkan kode pengelola yang kamu simpan saat membuat agenda. Setelah itu,
    browser ini bisa menetapkan waktu dan mengelola agenda.
  </p>

  <% if (error) { %>
  <div class="flash flash-error" role="alert"><p><%= error %></p></div>
  <% } %>

  <form class="form" method="post" action="/a/<%= agenda.slug %>/kelola" data-manage-login>
    <%- include('partials/csrf') %>
    <div class="field">
      <label for="kode">Kode pengelola</label>
      <input id="kode" type="password" name="kode" required autocomplete="off" spellcheck="false"
        maxlength="64" data-manage-code>
    </div>
    <button type="submit" class="button button-primary">Masuk</button>
  </form>

  <p><a href="/a/<%= agenda.slug %>">Kembali ke agenda</a></p>
</section>

<script type="module" src="/kelola.js"></script>

<%- include('partials/footer') %>
